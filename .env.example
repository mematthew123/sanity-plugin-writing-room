# For the dev Studio (`pnpm dev`): copy to .env.local (git-ignored) and fill in. The dev Studio writes real documents, so use a
# project and dataset you don't mind testing in. http://localhost:3333 must be a CORS origin of the
# project, with credentials (sanity.io/manage → API → CORS origins).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# For the browser tests (`pnpm e2e`): a token for the project above with the Editor role
# (sanity.io/manage → API → Tokens). The tests create Posts whose ids start `e2e-` in the dataset
# above and delete them again. Never commit it.
SANITY_E2E_TOKEN=
# Optional: your site's origin, to try Preview.
SANITY_STUDIO_PREVIEW_ORIGIN=
